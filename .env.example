DATABASE_URL_MIGRATOR=postgresql://pw_migrator:replace-with-migrator-secret@127.0.0.1:5432/projection_witness
DATABASE_URL_API=postgresql://pw_api:replace-with-api-secret@127.0.0.1:5432/projection_witness
DATABASE_URL_PROJECTOR=postgresql://pw_projector:replace-with-projector-secret@127.0.0.1:5432/projection_witness
DATABASE_URL_MCP_READ=postgresql://pw_mcp_read:replace-with-mcp-read-secret@127.0.0.1:5432/projection_witness
DATABASE_URL_MCP_WRITE=postgresql://pw_mcp_write:replace-with-mcp-write-secret@127.0.0.1:5432/projection_witness
POSTGRES_PORT=5432

API_BASE_URL=http://127.0.0.1:3000
API_PORT=3000
MCP_READ_PORT=8781
MCP_WRITE_PORT=8782
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_AGENT_NAME=projection-witness

PROJECTION_NAME=orders
PROJECTOR_MODE=gap-aware-v1
PROJECTOR_GENERATION=2
SOURCE_COMMIT_SHA=development
REDUCER_BUNDLE_PATH=./artifacts/order-reducer.4decce13b48e3aeff9402b36c13bf2a995b176f2c7e11e203c83d03b8b23e637.cjs

DEMO_MODE=false
PLAN_TTL_SECONDS=300
MAX_STREAM_EVENTS=1000
MAX_STREAM_BYTES=1048576
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000

# Windows only: npm database commands use this WSL distribution for Docker.
PW_WSL_DISTRO=Ubuntu