DATABASE_URL_MIGRATOR=postgresql://pw_migrator:change-me@127.0.0.1:5432/projection_witness
DATABASE_URL_API=postgresql://pw_api:change-me@127.0.0.1:5432/projection_witness
DATABASE_URL_PROJECTOR=postgresql://pw_projector:change-me@127.0.0.1:5432/projection_witness
DATABASE_URL_MCP_READ=postgresql://pw_mcp_read:change-me@127.0.0.1:5432/projection_witness
DATABASE_URL_MCP_WRITE=postgresql://pw_mcp_write:change-me@127.0.0.1:5432/projection_witness
POSTGRES_PORT=5432

API_BASE_URL=http://127.0.0.1:3000
API_PORT=3000
MCP_READ_PORT=8781
MCP_WRITE_PORT=8782
TRUEFORGE_BASE_URL=http://127.0.0.1:8790
TRUEFORGE_AGENT_NAME=projection-witness

PROJECTION_NAME=orders
PROJECTOR_MODE=gap-aware-v1
SOURCE_COMMIT_SHA=development
REDUCER_BUNDLE_PATH=./packages/reducer/dist/order-reducer.mjs

DEMO_MODE=false
PLAN_TTL_SECONDS=300
MAX_STREAM_EVENTS=1000
MAX_STREAM_BYTES=1048576
DB_LOCK_TIMEOUT_MS=2000
DB_STATEMENT_TIMEOUT_MS=5000

# Windows only: npm database commands use this WSL distribution for Docker.
PW_WSL_DISTRO=Ubuntu