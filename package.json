{
  "name": "projection-witness",
  "version": "0.0.0",
  "private": true,
  "description": "Proof-carrying, stale-safe repair for one event-sourced PostgreSQL projection row.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "build": "tsc --build && npm run build:reducer",
    "build:reducer": "tsx scripts/build-reducer-bundle.ts",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:e2e && npm run test:integration && npm run test:race && npm run build",
    "clean": "tsx scripts/clean.ts",
    "db:bootstrap-roles": "tsx scripts/bootstrap-runtime-roles.ts",
    "db:config": "tsx scripts/docker-compose.ts config",
    "db:down": "tsx scripts/docker-compose.ts down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/docker-compose.ts reset",
    "db:serve": "tsx scripts/docker-compose.ts serve",
    "db:up": "tsx scripts/docker-compose.ts up",
    "demo:reproduce-gap": "tsx scripts/reproduce-gap.ts",
    "demo:prepare-repair": "tsx scripts/prepare-repair-demo.ts",
    "demo:request-approval": "tsx scripts/run-approval-demo.ts",
    "demo:verify-repair": "tsx scripts/verify-repair-demo.ts",
    "demo:reset": "tsx scripts/docker-compose.ts demo-reset",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:projector:v1": "tsx apps/projector/src/run-naive-v1.ts",
    "dev:projector:v2": "tsx apps/projector/src/run-gap-aware-v2.ts",
    "dev:mcp": "tsx apps/mcp/src/run.ts",
    "evidence:build-envelope": "tsx scripts/build-repair-envelope.ts",
    "evidence:run-reducer": "tsx scripts/run-reducer-evidence.ts",
    "evidence:trueforge-daytona": "tsx scripts/run-trueforge-daytona-evidence.ts",
    "mcp:smoke": "tsx scripts/smoke-mcp.ts",
    "trueforge:reconnect": "tsx scripts/reconnect-agent-turn.ts",
    "trueforge:register": "tsx scripts/register-agent.ts",
    "trueforge:run": "tsx scripts/run-agent-turn.ts",
    "trueforge:verify-daytona": "tsx scripts/verify-trueforge-daytona-session.ts",
    "trueforge:verify-approved-repair": "tsx scripts/verify-trueforge-approved-repair.ts",
    "trueforge:verify-read-smoke": "tsx scripts/verify-trueforge-read-smoke.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run --config vitest.workspace.ts",
    "test:e2e": "vitest run --config vitest.workspace.ts tests/e2e",
    "test:integration": "tsx scripts/require-test-database-env.ts integration && vitest run --config vitest.workspace.ts tests/integration",
    "test:race": "tsx scripts/require-test-database-env.ts race && vitest run --config vitest.workspace.ts tests/race",
    "test:unit": "vitest run --config vitest.workspace.ts tests/unit",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "canonicalize": "4.0.0",
    "express": "5.2.1",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@truefoundry/trueforge": "0.1.4",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
