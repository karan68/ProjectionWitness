{
  "name": "projection-witness",
  "version": "0.0.0",
  "private": true,
  "description": "Proof-carrying, stale-safe repair for one event-sourced PostgreSQL projection row.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.9"
  },
  "packageManager": "npm@10.9.9",
  "scripts": {
    "build": "tsc --build",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:race && npm run build",
    "clean": "tsc --build --clean",
    "db:config": "tsx scripts/docker-compose.ts config",
    "db:down": "tsx scripts/docker-compose.ts down",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/docker-compose.ts reset",
    "db:serve": "tsx scripts/docker-compose.ts serve",
    "db:up": "tsx scripts/docker-compose.ts up",
    "demo:reproduce-gap": "tsx scripts/reproduce-gap.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "demo:verify": "tsx scripts/verify-demo.ts",
    "dev:api": "tsx apps/api/src/server.ts",
    "dev:projector:v1": "tsx apps/projector/src/run-naive-v1.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run --config vitest.workspace.ts --passWithNoTests",
    "test:e2e": "vitest run --config vitest.workspace.ts tests/e2e --passWithNoTests",
    "test:integration": "vitest run --config vitest.workspace.ts tests/integration --passWithNoTests",
    "test:race": "vitest run --config vitest.workspace.ts tests/race --passWithNoTests",
    "test:unit": "vitest run --config vitest.workspace.ts tests/unit --passWithNoTests",
    "typecheck": "tsc --build --pretty false"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@truefoundry/trueforge-sdk": "0.1.3",
    "canonicalize": "4.0.0",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "projection-witness": "file:",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@truefoundry/trueforge": "0.1.4",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
